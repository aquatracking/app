<!DOCTYPE html>
<html lang="{{ i18n.locale }}">
  <body>
    <p>{{ i18n.t('emails.password_reset.greeting', { firstName }) }}</p>
    <p>{{ i18n.t('emails.password_reset.intro') }}</p>
    <p><a href="{{ url }}">{{ i18n.t('emails.password_reset.action') }}</a></p>
    <p>{{ i18n.t('emails.password_reset.expiry') }}</p>
    <p>{{ i18n.t('emails.password_reset.ignore') }}</p>
  </body>
</html>
