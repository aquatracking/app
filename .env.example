# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development
LOG_LEVEL=info

# App
APP_KEY=
APP_URL=http://${HOST}:${PORT}
# Reverse proxies allowed to set X-Forwarded-For, comma separated (e.g. "loopback, 172.16.0.0/12")
TRUSTED_PROXIES=

# Database (compose.yml)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=aquatracking
DB_PASSWORD=aquatracking
DB_DATABASE=aquatracking

# Vivarium images
DRIVE_ROOT=storage

# Mail: leave SMTP_HOST empty to disable email (Mailpit from compose.yml below)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=false
MAIL_FROM_ADDRESS=aquatracking@example.com
MAIL_FROM_NAME=AquaTracking
